# Copy this file to ".env" for local use, or set these as environment variables
# in the Render dashboard. Never commit your real key.

# Your Anthropic API key (required for the AI "Generate My Plan" feature).
ANTHROPIC_API_KEY=

# Optional: restrict the AI endpoints to a specific site address.
# Not needed for the normal setup (the site and AI share one origin on Render).
# Only useful if another site calls this service cross-origin.
# ALLOWED_ORIGIN=https://tools.yoursite.com

# Optional: override the Claude model (defaults to claude-sonnet-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Optional: port for local runs (Render sets this automatically).
# PORT=3000
